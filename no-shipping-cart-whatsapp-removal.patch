@@ -0,0 +1,12 @@
+-- El envío ya no se calcula ni se cobra por este sistema: lo cubre el
+-- comprador aparte (por debajo de $250.000) o es gratis (regla informativa
+-- en el copy del sitio, no en la base de datos).
+alter table public.orders
+  drop column if exists shipping_cop,
+  drop column if exists shipping_department;
+
+-- La tabla shipping_zones queda sin uso (RLS la sigue bloqueando por
+-- completo; puedes borrarla manualmente si quieres limpiar del todo).
+
+-- Precio actualizado: $89.999 (antes $79.999/$74.999).
+update public.products set price_cop = 89999;

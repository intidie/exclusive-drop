# Cliente (Vite las expone en el bundle del navegador — nunca poner secretos aquí)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WOMPI_PUBLIC_KEY=

# Solo servidor (NO usar prefijo VITE_, así nunca llegan al navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Llave de "Firma de integridad" del comercio en el dashboard de Wompi.
WOMPI_INTEGRITY_SECRET=
# Secreto de eventos del dashboard de Wompi, para verificar el webhook.
WOMPI_EVENTS_SECRET=
